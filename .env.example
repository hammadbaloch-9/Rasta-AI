# ---------------------------------------------------------------------------
# RAASTA AI backend — environment configuration
# Copy to .env and adjust. Every value below is optional:
# the API runs out of the box with an in-memory store.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database -----------------------------------------------------------------
# DB_MODE: auto | mongo | memory
#   auto   -> use MongoDB when MONGODB_URI is reachable, otherwise in-memory
#   mongo  -> require MongoDB (startup fails if unreachable)
#   memory -> always use the ephemeral in-memory store
DB_MODE=auto
MONGODB_URI=mongodb://127.0.0.1:27017/raasta_ai
MONGODB_DB_NAME=raasta_ai
MONGODB_TIMEOUT_MS=5000

# --- HTTP ---------------------------------------------------------------------
# Comma-separated origins, or * for any origin (development default)
CORS_ORIGINS=*
LOG_LEVEL=info

# --- Simulation ---------------------------------------------------------------
SIM_TICK_SEC=1
SIM_DEFAULT_DURATION_SEC=600
SIM_MIN_DURATION_SEC=60
SIM_MAX_DURATION_SEC=3600
SIM_SAMPLE_INTERVAL_SEC=5
SIM_DECISION_LOG_LIMIT=250
SIM_RECORD_FRAME_INTERVAL_SEC=1
SIM_MAX_RECORDED_FRAMES=1200
SIM_MAX_FRAME_VEHICLE_ENTRIES=120000
SIM_MAX_VEHICLES=8000

# --- Live (Socket.IO streamed) runs -------------------------------------------
# Real milliseconds per simulated second (100 = 10x speed)
LIVE_TICK_MS=100

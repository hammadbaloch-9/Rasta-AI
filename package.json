{
  "name": "raasta-ai-backend",
  "version": "1.0.0",
  "description": "RAASTA AI \u2014 Karachi Smart Traffic Management System. Backend: REST API, deterministic traffic simulation engine, metrics, experiments, hotspots and recommendations.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "demo": "node scripts/demo.js",
    "verify:mongo": "node scripts/verify-mongo.js"
  },
  "keywords": [
    "traffic-simulation",
    "adaptive-signals",
    "karachi",
    "express",
    "mongodb",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "socket.io-client": "^4.8.4"
  }
}

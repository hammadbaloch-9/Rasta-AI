                "api",
                "scenarios"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('scenarios returned', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('four scenarios', () => pm.expect(j.data.length).to.eql(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Scenario detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/scenarios/{{scenarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",

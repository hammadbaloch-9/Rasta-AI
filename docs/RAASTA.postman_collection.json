{
  "info": {
    "name": "RAASTA AI \u2014 Backend API",
    "description": "Karachi Smart Traffic Management System backend. All results are simulated; see the README and docs/API.md. Run the API with `npm start`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "scenarioId",
      "value": "saddar-balanced"
    },
    {
      "key": "simulationId",
      "value": ""
    },
    {
      "key": "experimentId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health & metadata",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('healthy', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('db mode reported', () => pm.expect(['memory','mongo']).to.include(j.db.mode));"
                ]
              }
            }
          ]
        },
        {
          "name": "Metric definitions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/metrics/definitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "metrics",
                "definitions"
              ]
            },
            "description": ""
          },
          "response": []
        },
        {
          "name": "Command Center dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('dashboard ok', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Scenarios",
      "item": [
        {
          "name": "List scenarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/scenarios",
              "host": [
                "{{baseUrl}}"
              ],

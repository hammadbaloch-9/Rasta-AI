              ]
            },
            "description": ""
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Simulations",
      "item": [
        {
          "name": "Run \u2014 fixed baseline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/simulations/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "simulations",
                "run"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenarioId\": \"{{scenarioId}}\",\n  \"mode\": \"fixed\",\n  \"durationSec\": 600,\n  \"seed\": 42,\n  \"label\": \"Postman fixed baseline\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('simulationId', j.data.id);",
                  "pm.test('metrics measured', () => pm.expect(j.data.metrics.vehiclesSpawned).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run \u2014 adaptive",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/simulations/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "simulations",
                "run"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenarioId\": \"{{scenarioId}}\",\n  \"mode\": \"adaptive\",\n  \"durationSec\": 600,\n  \"seed\": 42,\n  \"label\": \"Postman adaptive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run \u2014 live (Socket.IO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/simulations/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "simulations",
                "run"
              ]
            },
            "description": "Returns 202 immediately. Subscribe to the room with the `simulation:subscribe` Socket.IO event.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenarioId\": \"{{scenarioId}}\",\n  \"mode\": \"adaptive\",\n  \"durationSec\": 300,\n  \"seed\": 7,\n  \"live\": true,\n  \"tickMs\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ]
        },
        {
          "name": "Compare fixed vs adaptive (3 seeds)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/simulations/compare",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "simulations",
                "compare"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenarioId\": \"{{scenarioId}}\",\n  \"durationSec\": 600,\n  \"seeds\": [\n    1,\n    2,\n    3\n  ],\n  \"label\": \"Postman experiment\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('experiment created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('experimentId', j.data.experiment.id);",
                  "pm.test('comparison rows present', () => pm.expect(j.data.comparison.rows.length).to.eql(10));"
                ]
              }
            }
          ]
        },
